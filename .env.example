# ============================================================
# support-crm/.env.example
# Safe template — commit this file, NOT .env
# Copy this file to .env and fill in your real values.
# ============================================================

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Supabase PostgreSQL ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://your_user:your_password@your_host:5432/postgres

# --- AI Mock Mode ---
# true  → no Gemini calls, uses realistic mock responses (use during development)
# false → real Gemini API calls (use only for final testing/demo)
AI_MOCK_MODE=true
